{
  "name": "thebigtreebjj",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm run build:hostinger",
    "build:hostinger": "pnpm db:generate && pnpm --filter @thebigtreebjj/api run build && pnpm --filter @thebigtreebjj/web run build",
    "start": "node scripts/start-hostinger.mjs",
    "start:hostinger": "node scripts/start-hostinger.mjs",
    "dev": "pnpm run dev:local",
    "dev:local": "pnpm -r --parallel --filter @thebigtreebjj/api --filter @thebigtreebjj/web run dev",
    "dev:docker": "docker compose up --build",
    "dev:api": "pnpm --filter @thebigtreebjj/api dev",
    "dev:web": "pnpm --filter @thebigtreebjj/web dev",
    "db:migrate": "node packages/database/node_modules/prisma/build/index.js migrate dev --schema packages/database/prisma/schema.prisma",
    "db:deploy": "node packages/database/node_modules/prisma/build/index.js migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:generate": "node packages/database/node_modules/prisma/build/index.js generate --schema packages/database/prisma/schema.prisma",
    "db:seed": "pnpm --filter @thebigtreebjj/database prisma:seed",
    "db:studio": "pnpm --filter @thebigtreebjj/database exec prisma studio",
    "db:import-status": "node scripts/db-import-status.mjs",
    "db:review-summary": "node scripts/db-review-summary.mjs"
  },
  "packageManager": "pnpm@11.17.0"
}
