generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Person {
  id              String               @id @default(cuid())
  fullName        String
  nicknames       String[]
  country         String?
  city            String?
  team            String?
  bio             String?
  profileUrl      String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  aliases         PersonAlias[]
  affiliations    PersonAffiliation[]
  studentClaims   LineageClaim[]       @relation("studentClaims")
  teacherClaims   LineageClaim[]       @relation("teacherClaims")
  changeHistories ChangeHistory[]
  importRows      ImportRow[]
}

model PersonAlias {
  id        String   @id @default(cuid())
  personId  String
  alias     String
  person    Person   @relation(fields: [personId], references: [id])
  createdAt DateTime @default(now())
}

model Organization {
  id           String               @id @default(cuid())
  name         String
  type         String
  foundedAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  affiliations PersonAffiliation[]
}

model Academy {
  id           String               @id @default(cuid())
  name         String
  organizationId String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model PersonAffiliation {
  id              String        @id @default(cuid())
  personId        String
  organizationId  String
  affiliationType String
  person          Person        @relation(fields: [personId], references: [id])
  organization    Organization  @relation(fields: [organizationId], references: [id])
  createdAt       DateTime      @default(now())
}

model LineageClaim {
  id                 String          @id @default(cuid())
  studentPersonId    String
  teacherPersonId    String?
  claimType          String
  relationshipLabel  String
  dateStart          DateTime?
  dateEnd            DateTime?
  location           String?
  status             String
  evidenceLevel      String
  confidenceScore    Float
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  studentPerson      Person          @relation("studentClaims", fields: [studentPersonId], references: [id])
  teacherPerson      Person?         @relation("teacherClaims", fields: [teacherPersonId], references: [id])
  evidences          ClaimEvidence[]
  reviewDecisions    ReviewDecision[]
  promotionGroupId   String?
  promotionGroup     PromotionGroup? @relation(fields: [promotionGroupId], references: [id])
}

model ClaimEvidence {
  id            String   @id @default(cuid())
  lineageClaimId String
  url           String
  sourceType    String
  captureDate   DateTime?
  author        String?
  curatorNotes  String?
  createdAt     DateTime @default(now())
  claim         LineageClaim @relation(fields: [lineageClaimId], references: [id])
}

model Source {
  id            String   @id @default(cuid())
  name          String
  url           String
  sourceType    String
  captureDate   DateTime?
  author        String?
  curatorNotes  String?
  createdAt     DateTime @default(now())
}

model ExternalSourceProfile {
  id                 String                 @id @default(cuid())
  sourceName         String                 @map("source_name")
  sourceProfileUrl   String                 @unique @map("source_profile_url")
  externalName       String                 @map("external_name")
  nickname           String?
  listedTeamText     String?                @map("listed_team_text")
  capturedAt         DateTime               @map("captured_at")
  sourceStatus       String                 @map("source_status")
  rawHash            String                 @map("raw_hash")
  createdAt          DateTime               @default(now()) @map("created_at")
  snapshots          ExternalProfileSnapshot[]
  factCandidates     ExternalFactCandidate[]
}

model ExternalProfileSnapshot {
  id                 String                @id @default(cuid())
  externalProfileId  String                @map("external_profile_id")
  sourceProfileUrl   String                @map("source_profile_url")
  capturedAt         DateTime              @map("captured_at")
  rawHash            String                @map("raw_hash")
  parsedPayload      String                @map("parsed_payload")
  sourceStatus       String                @map("source_status")
  createdAt          DateTime              @default(now()) @map("created_at")
  externalProfile    ExternalSourceProfile @relation(fields: [externalProfileId], references: [id])
}

model ExternalFactCandidate {
  id                 String                @id @default(cuid())
  externalProfileId  String                @map("external_profile_id")
  candidateType      String                @map("candidate_type")
  subjectName        String                @map("subject_name")
  objectName         String?               @map("object_name")
  structuredValue    String                @map("structured_value")
  sourceUrl          String                @map("source_url")
  sourceLocator      String                @map("source_locator")
  evidenceLevel      String                @map("evidence_level")
  status             String
  confidenceScore    Float                 @map("confidence_score")
  importedAt         DateTime              @map("imported_at")
  externalProfile    ExternalSourceProfile @relation(fields: [externalProfileId], references: [id])
}

model CrawlRun {
  id                 String   @id @default(cuid())
  connectorName      String   @map("connector_name")
  mode               String
  status             String
  dryRun             Boolean  @default(false) @map("dry_run")
  catalogDiscovered  Int      @default(0) @map("catalog_discovered")
  profilesQueued     Int      @default(0) @map("profiles_queued")
  profilesFetched    Int      @default(0) @map("profiles_fetched")
  profilesSkipped    Int      @default(0) @map("profiles_skipped")
  createdAt          DateTime @default(now()) @map("created_at")
  completedAt        DateTime? @map("completed_at")
  logs               CrawlLog[]
}

model CrawlLog {
  id                 String   @id @default(cuid())
  crawlRunId         String   @map("crawl_run_id")
  level              String
  message            String
  sourceUrl          String?  @map("source_url")
  createdAt          DateTime @default(now()) @map("created_at")
  crawlRun           CrawlRun @relation(fields: [crawlRunId], references: [id])
}

model OfficialObservation {
  id            String   @id @default(cuid())
  title         String
  description   String
  createdAt     DateTime @default(now())
}

model BlackBeltRegistry {
  id            String   @id @default(cuid())
  personId      String
  awardedBy     String?
  awardedAt     DateTime?
  createdAt     DateTime @default(now())
}

model CompetitionRecord {
  id            String   @id @default(cuid())
  personId      String
  eventName     String
  result        String?
  createdAt     DateTime @default(now())
}

model ReviewQueue {
  id            String   @id @default(cuid())
  entityType    String
  entityId      String
  status        String
  createdAt     DateTime @default(now())
}

model LineageSubmission {
  id                 String    @id @default(cuid())
  protocol           String    @unique
  fullName           String
  email              String
  instagram          String?
  teacherPersonId    String?
  teacherName        String
  academyTeam        String?
  city               String?
  country            String?
  promotionDate      DateTime?
  claimType          String    @default("black_belt_awarded_by")
  graduationTrack    String?
  certificateCompletenessConfirmed Boolean @default(false)
  evidenceUrls       String[]
  evidenceNotes      String?
  certificateOriginalName String?
  certificateMimeType String?
  certificateSize    Int?
  certificateStoragePath String?
  certificateSha256  String?
  consent            Boolean
  status             String    @default("pending_review")
  personId           String?
  lineageClaimId     String?
  reviewerNotes      String?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  certificates       LineageSubmissionCertificate[]

  @@index([status, createdAt])
}

model LineageSubmissionCertificate {
  id             String    @id @default(cuid())
  submissionId   String
  track          String
  beltRank       String
  beltLabel      String
  sequence       Int
  awardedAt      DateTime?
  originalName   String
  mimeType       String
  size           Int
  storagePath    String
  sha256         String
  createdAt      DateTime  @default(now())
  submission     LineageSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, sequence])
}

model ChangeHistory {
  id             String   @id @default(cuid())
  entityType     String
  entityId       String
  action         String
  changedBy      String?
  createdAt      DateTime @default(now())
  details        String?
  personId       String?
  person         Person?  @relation(fields: [personId], references: [id])
}

model ImportJob {
  id               String      @id @default(cuid())
  fileName         String
  originalFileName String
  importType       String
  importCategory   String?
  status           String      @default("uploaded")
  storagePath      String?
  fileSize         Int?
  uploadedBy       String?
  summary          String?
  result           String?
  metadata         String?
  mapping          String?
  validationSummary String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  importRows       ImportRow[]
}

model ImportRow {
  id                 String      @id @default(cuid())
  importJobId        String
  originalFileName   String
  originalRowNumber  Int
  rawPayload         String
  validationResult   String
  entityType         String?
  createdEntityId    String?
  status             String      @default("pending")
  importedAt         DateTime    @default(now())
  importJob          ImportJob   @relation(fields: [importJobId], references: [id])
  personId           String?
  person             Person?     @relation(fields: [personId], references: [id])
}

model DuplicateCandidate {
  id           String   @id @default(cuid())
  entityType   String
  entityName   String
  confidence    Float
  status       String
  notes        String?
  createdAt    DateTime @default(now())
}

model ReviewDecision {
  id           String   @id @default(cuid())
  lineageClaimId String
  action       String
  notes        String?
  reviewerId   String?
  createdAt    DateTime @default(now())
  claim        LineageClaim? @relation(fields: [lineageClaimId], references: [id])
}

model PromotionGroup {
  id           String   @id @default(cuid())
  title        String
  notes        String?
  createdAt    DateTime @default(now())
  claims       LineageClaim[]
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
