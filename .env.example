NODE_ENV=development
POSTGRES_DB=thebigtreebjj
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/thebigtreebjj?schema=public
# Optional direct/session connection used by production migrations.
DIRECT_URL=
REDIS_URL=redis://redis:6379
API_PORT=3001
WEB_PORT=3000
JWT_SECRET=change-me-in-production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Optional Google Tag Manager container override (public; e.g. GTM-XXXXXXX)
GOOGLE_TAG_MANAGER_ID=

# Optional Google Analytics 4 Measurement ID override (public; e.g. G-XXXXXXXXXX)
GOOGLE_ANALYTICS_ID=
