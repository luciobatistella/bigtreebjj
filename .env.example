NODE_ENV=development
POSTGRES_DB=thebigtreebjj
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/thebigtreebjj?schema=public
# Optional direct/session connection used by production migrations.
DIRECT_URL=
REDIS_URL=redis://redis:6379
API_PORT=3001
WEB_PORT=3000

# Supabase Auth (the publishable key is safe for browser use; never expose the secret key).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Comma-separated editorial allowlist. Alternatively, set app_metadata.role=admin
# on the user in Supabase Auth.
ADMIN_EMAILS=admin@example.com

# Optional Google Tag Manager container override (public; e.g. GTM-XXXXXXX)
GOOGLE_TAG_MANAGER_ID=

# Optional Google Analytics 4 Measurement ID override (public; e.g. G-XXXXXXXXXX)
GOOGLE_ANALYTICS_ID=
